{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-thai-smart-trip2",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-23",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
